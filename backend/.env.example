# ============================================================
# Carbon Horizon — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ── Environment ─────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production
DEBUG=True

# ── Database ─────────────────────────────────────────────────
# Development (SQLite — zero config, no server required):
DATABASE_URL=sqlite:///./carbonhorizon.db

# Production (PostgreSQL — uncomment and fill in):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/carbonhorizon

# Async URL is auto-derived from DATABASE_URL.
# Override only if you need a different async driver:
# ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/carbonhorizon

# ── JWT / Auth ───────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-32-char-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
