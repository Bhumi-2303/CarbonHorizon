FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .

# Build-time Vite arguments baked into frontend bundle
ARG VITE_APP_URL
ARG VITE_API_URL
ARG VITE_ANALYTICS_DOMAIN
ARG VITE_TURNSTILE_SITE_KEY

ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ANALYTICS_DOMAIN=$VITE_ANALYTICS_DOMAIN
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template
EXPOSE 80
CMD ["/bin/sh", "-c", "if [ -z \"$BACKEND_URL\" ]; then echo 'FATAL: BACKEND_URL environment variable is required in production' >&2; exit 1; fi && envsubst '${BACKEND_URL}' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
