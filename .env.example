# ============================================================
# Carbon Horizon — Root Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ── Environment ─────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────
# For local Docker Compose fallback:
POSTGRES_USER=carbon_user
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=carbonhorizon
# Production database (e.g. Neon PostgreSQL — sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://carbon_user:changeme_use_strong_password@localhost:5432/carbonhorizon

# ── Redis (Token Revocation Blocklist) ───────────────────────
# For local Docker Compose / dev: redis://localhost:6379/0
# For production (e.g. external Upstash Redis):
# REDIS_URL=rediss://default:password@xyz.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
REDIS_FAIL_OPEN=false

# ── JWT / Auth Security ──────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Allowed origins for frontend requests (JSON array or comma-separated)
# In development:
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# In production (set to your Vercel frontend origin):
# ALLOWED_ORIGINS=["https://carbonhorizon.vercel.app"]

# ── External AI APIs ────────────────────────────────────────
# Optional: Required for AI Climate Coach chat (/coach/chat)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Cloud / Secret Manager ────────────────────────────
# Optional: If running on GCP with Secret Manager integration
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# USE_SECRET_MANAGER=false
